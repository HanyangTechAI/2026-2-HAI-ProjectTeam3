{
  "pretrained_model_name_or_path": "models/generation/realistic-vision-v5.1",
  "train_data_dir": "data/lora/train",
  "image_column": "image",
  "caption_column": "text",
  "resolution": 512,
  "center_crop": true,
  "random_flip": true,
  "rank": 16,
  "train_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "gradient_checkpointing": true,
  "mixed_precision": "fp16",
  "learning_rate": 0.0001,
  "lr_scheduler": "constant",
  "lr_warmup_steps": 0,
  "adam_beta1": 0.9,
  "adam_beta2": 0.999,
  "adam_weight_decay": 0.01,
  "adam_epsilon": 1e-8,
  "max_grad_norm": 1.0,
  "max_train_steps": 10,
  "checkpointing_steps": 5,
  "checkpoints_total_limit": 2,
  "dataloader_num_workers": 0,
  "report_to": "none",
  "seed": 42
}
